# Copy this file to .env and update values for your environment.
SECRET_KEY=replace-with-a-long-random-secret
# MySQL example: mysql+pymysql://govnexus_user:strong-password@localhost/govnexus?charset=utf8mb4
# SQLite is useful for a quick local demo; MySQL is recommended for shared/deployed use.
DATABASE_URL=sqlite:///govnexus.db
BOOTSTRAP_ADMIN_USERNAME=Admin123
BOOTSTRAP_ADMIN_PASSWORD=change-this-password-before-use
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=10485760
